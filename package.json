{
  "name": "claude-highlight",
  "version": "1.0.0",
  "type": "module",
  "description": "Colors epistemic markers in Claude Code's output, live, in the terminal",
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "pty",
    "terminal",
    "ansi",
    "highlight",
    "hedging",
    "epistemic",
    "uncertainty",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoahBPeterson/claude-highlight.git"
  },
  "bugs": {
    "url": "https://github.com/NoahBPeterson/claude-highlight/issues"
  },
  "homepage": "https://github.com/NoahBPeterson/claude-highlight#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "claude-highlight": "./dist/claude-highlight.js"
  },
  "man": [
    "./man/claude-highlight.1"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/claude-highlight.ts src/pty-read-worker.ts src/pty-write-worker.ts --target=node --packages=external --splitting --outdir=dist",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.json",
    "test:pty": "node test/pty-smoke.ts",
    "test:filter": "node test/test_filter.ts",
    "test:screen": "node test/test_screen.ts",
    "test:integration": "node test/test_integration.ts",
    "test:wrapper": "node test/test_wrapper.ts",
    "test:paste": "node test/test_paste.ts",
    "test:miners": "node test/test_miners.ts",
    "test:all": "node test/run_all.ts",
    "test:dist": "bun run build && CLAUDE_HIGHLIGHT_BIN=\"$PWD/dist/claude-highlight.js\" node test/run_all.ts",
    "test:all:bun": "bun run test/run_all.ts",
    "test:dist:bun": "bun run build && CLAUDE_HIGHLIGHT_BIN=\"$PWD/dist/claude-highlight.js\" bun run test/run_all.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "bun-types": "^1.4.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15"
  }
}
